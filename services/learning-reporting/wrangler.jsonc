{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "learning-reporting",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "learning-reporting",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "SYNC_LIMITER",
      "namespace_id": "2001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "ENROLL_LIMITER",
      "namespace_id": "2002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "vars": {
    "REPORTING_ENABLED": "false",
    "ALLOWED_ORIGINS": "",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "RETENTION_DAYS": "90",
    "DISPLAY_TIME_ZONE": "UTC"
  }
}
